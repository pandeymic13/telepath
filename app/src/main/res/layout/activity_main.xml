<?xml version="1.0" encoding="utf-8"?>
<!-- Sized in dp for a 960x540dp TV canvas (1080p and 4K both map to it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F6">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Legibility veil behind Continue Watching and the dock, coloured per theme. The clock needs none: it picks
         white or ink text for each photo (updateHeaderLook). -->
    <View
        android:id="@+id/scrimBottom"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no" />

    <!-- The widgets page frosts the wallpaper: a tiny blurred copy that fades in as the page scrolls down. -->
    <ImageView
        android:id="@+id/wallpaperFrost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <dev.plume.HomeScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <!-- Page 1, exactly one screen tall (HomeScrollView sizes it): the clock, open wallpaper,
                 Continue Watching, and the favourites dock resting on the bottom edge. -->
            <LinearLayout
                android:id="@+id/homePage"
                android:layout_width="match_parent"
                android:layout_height="540dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/homeHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingTop="28dp">

                    <!-- The clock and Up next straight on the photo. Its glass plate stays hidden unless the photo
                         behind is too mixed for white or ink text; the negative margins keep the text in place. -->
                    <LinearLayout
                        android:id="@+id/headerBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-16dp"
                        android:layout_marginTop="-12dp"
                        android:layout_marginBottom="-12dp"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextClock
                                android:id="@+id/clock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-light"
                                android:format12Hour="h:mm"
                                android:format24Hour="HH:mm"
                                android:includeFontPadding="false"
                                android:textSize="36sp" />

                            <TextClock
                                android:id="@+id/date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:format12Hour="EEEE, d MMMM"
                                android:format24Hour="EEEE, d MMMM"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Up next: the next match or session for the followed teams, beside the clock. Text only, like
                             the clock, so the wallpaper stays clear. Filled in by UpNext. -->
                        <View
                            android:id="@+id/upNextRule"
                            android:layout_width="1dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="22dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/upNext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="20dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/upNextTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxWidth="420dp"
                                android:maxLines="1"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/upNextWhen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxWidth="420dp"
                                android:maxLines="1"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Network status only; settings live in the Shortcuts row. -->
                    <ImageView
                        android:id="@+id/wifi"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/network_settings"
                        android:focusable="false"
                        android:src="@drawable/ic_wifi" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/watchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="2dp"
                    android:text="@string/continue_watching"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/watchStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/watchEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginTop="10dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/cw_empty"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Room around the cards for the focus lift; SnapScrollView clips at its own edges, just short of the
                     next card (the 14 dp overhang is under the 16 dp card gap). -->
                <dev.plume.SnapScrollView
                    android:id="@+id/watchScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-14dp"
                    android:layout_marginEnd="-14dp"
                    android:clipToPadding="false"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/watchRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:orientation="horizontal" />
                </dev.plume.SnapScrollView>

                <!-- Only shown while reordering favourites (it carries the instructions). -->
                <TextView
                    android:id="@+id/appsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="2dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- The favourites dock: frosted glass, banners edge to edge. -->
                <FrameLayout
                    android:id="@+id/dock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <dev.plume.SnapScrollView
                        android:id="@+id/appScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="12dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/appRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:clipChildren="false"
                            android:orientation="horizontal" />
                    </dev.plume.SnapScrollView>
                </FrameLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="18dp" />
            </LinearLayout>

            <!-- Page 2: Inputs and Shortcuts, then Weather and Watchlist (built by PersonalDashboard). -->
            <LinearLayout
                android:id="@+id/widgetsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="30dp" />
        </LinearLayout>
    </dev.plume.HomeScrollView>

    <!-- All apps: frosted overlay of banners; Back closes it. -->
    <ScrollView
        android:id="@+id/allApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="40dp"
        android:paddingTop="30dp"
        android:paddingEnd="40dp"
        android:paddingBottom="30dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/allAppsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-light"
                android:text="@string/all_apps"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/allAppsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/all_apps_hint"
                android:textSize="12sp" />

            <!-- Streaming, then Apps & utilities: a heading and a grid each, built by openAllApps. -->
            <LinearLayout
                android:id="@+id/allAppsSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Launcher settings: side panel over a dimmed home screen; Back closes it. -->
    <FrameLayout
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="40dp"
            android:paddingEnd="48dp"
            android:paddingBottom="27dp">

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:text="@string/plume_settings"
                android:textSize="20sp" />

            <!-- Scrolls once the rows outgrow the screen; focus moving down scrolls it along. -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
